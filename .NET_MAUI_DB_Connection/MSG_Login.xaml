<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="msg_MAUI2.MSG_Login"
             Title="MSG_Login"
             BackgroundColor="black">

    <ScrollView Padding="20">
        <VerticalStackLayout Spacing="15" VerticalOptions="Start">
            <Label
                Text="Welcome to MSG Paintball"
                FontSize="24"
                FontAttributes="Bold"
               HorizontalOptions="Center"
                TextColor="Red"
                FontFamily="time"
                />

            <!--Full Name-->
            <VerticalStackLayout Spacing="5">
                <Label
                    Text="Username" 
                    FontAttributes="Bold"
                    TextColor="Red"
                    HorizontalOptions="Center"/>
                <Entry 
                    WidthRequest="350" 
                    HorizontalOptions="Center"
                    Placeholder="Enter your first name"
                    Background="Grey"
                    />
            </VerticalStackLayout>
            <VerticalStackLayout Spacing="5">
                <Label
                    Text="Password"
                    FontAttributes="Bold"
                    TextColor="Red"
                    HorizontalOptions="Center"/>
                <Entry
                    WidthRequest="350"
                    HorizontalOptions="Center"
                    Placeholder="Enter your password"
                    BackgroundColor="Grey"
                    />
            </VerticalStackLayout>
            <VerticalStackLayout>
                <Button
                    WidthRequest="100"
                    BackgroundColor="Red"
                    Text="Login"
                    Clicked="OnLoginClicked"
                    />
            </VerticalStackLayout>


        </VerticalStackLayout>



    </ScrollView>

</ContentPage>
